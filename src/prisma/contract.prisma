// use prisma-next

model User {
  id              Uuid     @id @default(uuid())
  name            String
  email           String
  normalizedEmail String   @unique
  phone           String?
  normalizedPhone String?  @unique
  createdAt       DateTime @default(now())
  updatedAt       temporal.updatedAt()

  passwordCredential PasswordCredential?
  oauthAccounts OAuthAccount[]

  contacts Contact[]
}

model PasswordCredential {
  userId       Uuid   @id
  passwordHash String

  user User @relation(
    fields: [userId],
    references: [id],
    onDelete: Cascade
  )
}

model OAuthAccount {
  id                Uuid   @id @default(uuid())
  userId            Uuid
  provider          String
  providerAccountId String
  createdAt         DateTime @default(now())

  user User @relation(
    fields: [userId],
    references: [id],
    onDelete: Cascade
  )

  @@unique([provider, providerAccountId])
  @@unique([userId, provider])
  @@index([userId])
}

model PendingRegistration {
  id                   Uuid     @id @default(uuid())
  name                 String
  email                String
  normalizedEmail      String   @unique
  passwordHash         String
  verificationCodeHash String

  expiresAt            DateTime
  attemptCount         Int      @default(0)

  lastCodeIssuedAt      DateTime @default(now())
  resendCount           Int      @default(0)
  resendWindowStartedAt DateTime @default(now())
  lockedUntil           DateTime?

  createdAt            DateTime @default(now())
  updatedAt            temporal.updatedAt()
}

model ExpiredRegistration {
  id              Uuid     @id @default(uuid())
  name            String
  email           String
  normalizedEmail String

  registeredAt    DateTime
  expiredAt       DateTime @default(now())

  @@index([normalizedEmail])
}

model Contact {
  id                    Uuid     @id @default(uuid())
  userId                Uuid
  displayName           String
  normalizedDisplayName String
  createdAt             DateTime @default(now())
  updatedAt             temporal.updatedAtString()

  user User @relation(
    fields: [userId],
    references: [id],
    onDelete: Cascade
  )

  phones ContactPhone[]
  emails ContactEmail[]

  @@unique([userId, normalizedDisplayName])
  @@unique([id, userId])
}

model ContactPhone {
  id              Uuid     @id @default(uuid())
  contactId       Uuid
  userId          Uuid
  phone           String
  normalizedPhone String
  createdAt       DateTime @default(now())
  updatedAt       temporal.updatedAtString()

  contact Contact @relation(
    fields: [contactId, userId],
    references: [id, userId],
    onDelete: Cascade
  )

  @@unique([userId, normalizedPhone])
}

model ContactEmail {
  id              Uuid     @id @default(uuid())
  contactId       Uuid
  userId          Uuid
  email           String
  normalizedEmail String
  createdAt       DateTime @default(now())
  updatedAt       temporal.updatedAtString()

  contact Contact @relation(
    fields: [contactId, userId],
    references: [id, userId],
    onDelete: Cascade
  )

  @@unique([userId, normalizedEmail])
}